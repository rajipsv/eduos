# Copy to .env and fill in values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT auth (Option A) — required together for server-side login on Vercel/Neon
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional token lifetimes (seconds)
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_SEC=2592000

# Optional server settings
PORT=8888
HOST=127.0.0.1

# Production safety
# Demo accounts (password demo123) are seeded only when this is true. Default: on locally, off in production.
# ENABLE_DEMO_SEED=false
# Public URL used in password-reset emails, e.g. https://tutorsala.app
APP_URL=
# Extra origins allowed to call the API cross-origin (comma-separated). Same-origin needs nothing.
ALLOWED_ORIGINS=

# Website emails (password reset, login invites). Use ONE of these:
# a) Your mailbox over SMTP (e.g. Hostinger: smtp.hostinger.com, port 465, full email as user)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# b) Resend (https://resend.com)
RESEND_API_KEY=
# Sender shown to people. With SMTP it must be the SMTP mailbox (or an alias of it).
EMAIL_FROM=Tutorsala <hello@tutorsala.com>

# Encrypts center API keys (OpenAI, WhatsApp) stored in the database. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes saved keys unreadable (centers re-enter them).
SECRETS_ENCRYPTION_KEY=

# Optional platform-wide OpenAI key for centers without their own, and the model to use.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Database tests (npm run test:db) run in a throwaway schema on this database.
# Defaults to DATABASE_URL when not set.
# TEST_DATABASE_URL=
